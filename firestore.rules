rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidText(text, maxLen) {
      return text is string && text.size() <= maxLen;
    }

    // Public directories & reference data (read by anyone/bots, managed by admins)
    match /branches/{branchId} {
      allow read: if true;
      allow write: if true;
    }

    match /embassies/{embassyId} {
      allow read: if true;
      allow write: if true;
    }

    match /websites/{websiteId} {
      allow read: if true;
      allow write: if true;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    // News broadcasts and messenger channels
    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if true;
    }

    match /broadcast_categories/{catId} {
      allow read: if true;
      allow write: if true;
    }

    match /broadcast_channels/{chanId} {
      allow read: if true;
      allow write: if true;
    }

    // Job portal & job seekers
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    match /job_seekers/{seekerId} {
      allow read: if true;
      allow write: if true;
    }

    // Document expiry monitoring & reminders
    match /monitored_documents/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Staff and operator management
    match /staff_members/{staffId} {
      allow read: if true;
      allow write: if true;
    }

    // Messenger bot support inbox & tickets
    match /support_messages/{msgId} {
      allow read: if true;
      allow write: if true;
    }

    // Bot configurations & live analytics
    match /bot_configs/{configId} {
      allow read, write: if true;
    }

    match /bot_users/{userId} {
      allow read, write: if true;
    }

    match /analytics/{analyticId} {
      allow read, write: if true;
    }

    // User requests and appointment forms
    match /requests/{requestId} {
      allow read, write: if true;
    }

    // Kefalat Office Feedbacks and Satisfaction Surveys
    match /office_feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Found and Lost Documents Registry
    match /found_documents/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /lost_document_alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }

    // Printed Electronic Tazkira Distribution Records
    match /printed_tazkiras/{tazkiraId} {
      allow read: if true;
      allow write: if true;
    }

    // Education, Scholarships & School Admissions
    match /education_bulletins/{bulletinId} {
      allow read: if true;
      allow write: if true;
    }

    match /student_consultations/{consultId} {
      allow read: if true;
      allow write: if true;
    }

    // Smart Inquiries: Embassy Passports, Khodnevis, FIDA & Inquiry Logs
    match /embassy_passports/{passportId} {
      allow read: if true;
      allow write: if true;
    }

    match /khodnevis_contracts/{contractId} {
      allow read: if true;
      allow write: if true;
    }

    match /fida_records/{fidaId} {
      allow read: if true;
      allow write: if true;
    }

    match /inquiry_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
